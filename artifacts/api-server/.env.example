# PRIMER API server (artifacts/api-server) — environment reference.
# Copy to .env (git-ignored; never commit real values) and fill in.
# Every variable below is read from the process environment — no .env loader
# runs in production; the container platform supplies them.

# ── Required ────────────────────────────────────────────────────────────────

# TCP port the server binds. The process exits at boot without it.
PORT=8080

# PostgreSQL connection string. Authenticated routes, the audit log, and all
# lib/db tooling (migrate, seed) read it. Boot succeeds without it only until
# the first authenticated request, so set it in every real deployment.
DATABASE_URL=postgres://user:password@localhost:5432/primer

# HMAC key for signed session cookies — at least 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

# MJ Instinctive Intelligence origin. Remote deployments must use HTTPS.
# Example: https://u1-organism.example
MJ_ORGANISM_BASE_URL=

# Shared high-entropy secret for the server-to-server MJ synthesis endpoint.
# Must match COMPANION_SHARED_SECRET on the MJ Organism deployment.
# Generate with: openssl rand -hex 32
MJ_ORGANISM_COMPANION_TOKEN=

# Which tutor brain to use: scripted | gemma-local | anthropic | openai | gemini.
# scripted (default) is deterministic and does not perform model inference.
# gemma-local is the intended local-first launch provider.
# Cloud providers are development-only. Unsupported or missing-key selections
# fail loud at startup; there is no silent provider fallback.
TUTOR_PROVIDER=scripted

# Gemma-local OpenAI-compatible endpoint (Ollama default shown).
# Keep the inference server on the same trusted device/network as the API.
# GEMMA_LOCAL_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
# GEMMA_LOCAL_MODEL=gemma3:4b
# GEMMA_LOCAL_API_KEY=

# Cloud provider keys — required only when TUTOR_PROVIDER selects that provider.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Model overrides (cloud providers are dev-only).
# TUTOR_ANTHROPIC_MODEL=claude-sonnet-4-5
# TUTOR_OPENAI_MODEL=gpt-4o
# TUTOR_GEMINI_MODEL=gemini-2.0-flash

# Cloud provider HTTP timeout (ms) and rate limit (requests/minute).
# TUTOR_PROVIDER_TIMEOUT_MS=30000
# TUTOR_PROVIDER_MAX_RPM=30

# pino log level (default: info).
# LOG_LEVEL=info

# production enables the secure flag on session cookies and JSON logs.
# NODE_ENV=production
