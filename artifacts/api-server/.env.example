# PRIMER API server (artifacts/api-server) — environment reference.
# Copy to .env (git-ignored; never commit real values) and fill in.
# Every variable below is read from the process environment — no .env loader
# runs in production; the container platform supplies them.

# ── Required ────────────────────────────────────────────────────────────────

# TCP port the server binds. The process exits at boot without it.
PORT=8080

# PostgreSQL connection string. Authenticated routes, the audit log, and all
# lib/db tooling (migrate, seed) read it. Boot succeeds without it only until
# the first authenticated request, so set it in every real deployment.
DATABASE_URL=postgres://user:password@localhost:5432/primer

# HMAC key for signed session cookies — at least 32 characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────

# Which tutor brain to use: scripted | anthropic | openai | gemini.
# `scripted` (default) is deterministic and needs no key. Cloud providers are
# DEVELOPMENT-ONLY per the 2026-10-30 local-first decision; the launch tier is
# Gemma-local. An unknown value or a missing key fails loud at startup.
TUTOR_PROVIDER=scripted

# Provider keys — required only when TUTOR_PROVIDER selects that provider.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Model overrides (defaults shown; cloud providers are dev-only).
# TUTOR_ANTHROPIC_MODEL=claude-sonnet-4-5
# TUTOR_OPENAI_MODEL=gpt-4o
# TUTOR_GEMINI_MODEL=gemini-2.0-flash

# Cloud provider HTTP timeout (ms) and rate limit (requests/minute) —
# positive integers; invalid values fall back to these defaults.
# TUTOR_PROVIDER_TIMEOUT_MS=30000
# TUTOR_PROVIDER_MAX_RPM=30

# pino log level (default: info). Set to debug/trace while diagnosing.
# LOG_LEVEL=info

# production enables the secure flag on session cookies and JSON logs;
# any other value keeps cookies non-secure and pretty-prints logs.
# NODE_ENV=production
