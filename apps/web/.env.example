# Server-side origin of the Express API (artifacts/api-server).
# Next.js rewrites /api/* to this origin. Set this in the web deployment
# environment; do not prefix with NEXT_PUBLIC_.
API_PROXY_TARGET=http://127.0.0.1:8080

# Legacy browser API origin used by older client helpers. Leave unset unless
# a specific feature still reads it.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
